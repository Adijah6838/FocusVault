{
  "name": "focusvault",
  "version": "1.0.0",
  "private": true,
  "description": "FocusVault - Offline Productivity and Workload Intelligence Desktop Application",
  "main": "dist/main/main.js",
  "scripts": {
    "test": "node --test tests/test.js",
    "clean": "node scripts/clean.js",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/app.ts --bundle --outfile=dist/renderer/app.js --platform=browser --format=iife --target=es2020 --sourcemap",
    "build:assets": "node scripts/copy-assets.js",
    "build": "npm run clean && npm run build:main && npm run build:renderer && npm run build:assets",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^31.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
